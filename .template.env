# Secrets-only template.
# Put runtime configuration (models, prompts, MCP servers, logging, read_only) in config.yaml.

OPENAI_API_KEY=Your-OpenAi-Key

# Docker Compose defaults to the host machine broker at http://host.docker.internal:1026.
# Override these when brokers run elsewhere.
# FIWARE_CB_BASE_URL=http://host.docker.internal:1026
# FIWARE_CB_BASE_URL_CONTEXT_DATA_LOADER=http://host.docker.internal:1026
# FIWARE_CB_BASE_URL_MCP_EXPERIMENTS=http://host.docker.internal:1026
